#!/bin/bash

# Bundle the qrgen app's generator into renderer.js, which the panel loads
# straight into QML's JavaScript engine.
#
# This runs at development time, not at install time. The bundle is committed,
# so the plugin has no build step, no node_modules and no runtime beyond the
# shell itself — which is the point: a bar widget should not ask anyone to
# install a JavaScript toolchain to draw a square.
#
#   bin/build-renderer [path-to-qrgen-checkout]
#
# Three things happen here, and each one exists because QML's engine is not a
# browser:
#
#   1. bun bundles the app's generator as ESM. Not CommonJS: bun's CJS interop
#      helper uses `??=`, and one operator QML cannot parse makes the whole
#      file unloadable.
#   2. tsc downlevels it to ES2017. QML's coverage of newer syntax is patchy in
#      ways that are hard to predict — it takes optional chaining but rejects
#      object rest in a destructuring pattern, which lean-qr's own `generate`
#      uses. Downlevelling settles the whole class of problem rather than
#      chasing operators one at a time.
#   3. The ESM export statement becomes a plain `var`. QML runs a .js file and
#      exposes its top-level declarations as properties of the import, so that
#      `var` is the entire interface.
#
# The compressor is deliberately not in here: it needs BigInt, which QML's
# engine does not have. See bin/qrgen-compress.

set -euo pipefail

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin=$(cd -- "$here/.." && pwd)
app=${1:-$HOME/Projects/qrgen}

[[ -d $app/src/lib ]] || { echo "No qrgen checkout at $app" >&2; exit 1; }
command -v bun >/dev/null || { echo "bun is needed to build the bundle" >&2; exit 1; }
[[ -d $app/node_modules/lean-qr ]] || { echo "Run: bun install --cwd $app" >&2; exit 1; }
tsc="$app/node_modules/.bin/tsc"
[[ -x $tsc ]] || { echo "No tsc at $tsc — run: bun install --cwd $app" >&2; exit 1; }

work=$(mktemp -d)
entry="$app/.qrgen-plugin-entry.ts"
trap 'rm -rf "$work" "$entry"' EXIT

# The entry lives inside the checkout for the length of the build so its
# relative imports and node_modules resolve exactly as the app's own do.
cat > "$entry" <<'ENTRY'
// Built into the plugin's renderer.js — see bin/build-renderer.
//
// The surface the QML panel needs, and nothing more. Options arrive as a plain
// object and an SVG string comes back: no filesystem, no DOM, no network on
// either side, which is what lets this run inside QML's own engine.
import { buildMatrix } from "./src/lib/qrcode";
import { renderSVG } from "./src/lib/render";
import { bodyShapes, eyeFrameShapes, eyeBallShapes } from "./src/lib/shapes";
import { defaultOptions } from "./src/lib/options";

const list = (registry: Record<string, { label: string }>) =>
  Object.entries(registry).map(([value, shape]) => ({ value, label: shape.label }));

/** The shape menus, so the panel's dropdowns come from the app, not a copy. */
export function registries () {
  return {
    body: list(bodyShapes),
    eyeFrame: list(eyeFrameShapes),
    eyeBall: list(eyeBallShapes),
    defaults: defaultOptions
  };
}

/**
 * Build one code. `text` is what actually goes in — already compressed, if it
 * was going to be. Never throws: a failure is a result the panel can show.
 */
export function render (text: string, options: any, alphanumeric: boolean) {
  try {
    if (!text) return { ok: false, error: "Nothing to encode" };
    const merged = {
      ...defaultOptions,
      ...options,
      shapes: { ...defaultOptions.shapes, ...(options?.shapes ?? {}) },
      colors: { ...defaultOptions.colors, ...(options?.colors ?? {}) },
      logo: { ...defaultOptions.logo, ...(options?.logo ?? {}) }
    };
    const matrix = buildMatrix(text, { correction: merged.correction, alphanumeric: !!alphanumeric });
    return { ok: true, svg: renderSVG(matrix, merged), size: matrix.size, version: matrix.version };
  } catch (error) {
    return { ok: false, error: error instanceof Error ? error.message : String(error) };
  }
}

/** Version only — what the automatic settings compare candidates by. */
export function versionOf (text: string, correction: string, alphanumeric: boolean) {
  try {
    return buildMatrix(text, { correction: correction as any, alphanumeric: !!alphanumeric }).version;
  } catch {
    return -1;
  }
}
ENTRY

bun build "$entry" \
  --format=esm \
  --target=browser \
  --conditions=import \
  --minify \
  --outfile "$work/bundle.js" >/dev/null

"$tsc" "$work/bundle.js" --ignoreConfig --target ES2017 --module ESNext \
  --allowJs --outDir "$work/es2017" >/dev/null

down="$work/es2017/bundle.js"
[[ -f $down ]] || { echo "tsc produced nothing" >&2; exit 1; }

exports_line=$(grep -oE 'export[[:space:]]*\{[^}]*\}[[:space:]]*;?' "$down" | tail -1)
[[ -n $exports_line ]] || { echo "No export statement in the bundle" >&2; exit 1; }

# "export{Ae as registries,Qe as render}" -> "  registries: Ae,\n  render: Qe"
members=$(sed -E 's/^export[[:space:]]*\{//; s/\}[[:space:]]*;?$//' <<<"$exports_line" |
  tr ',' '\n' |
  sed -E 's/^ *([A-Za-z0-9_$]+) as ([A-Za-z0-9_$]+) *$/  \2: \1/' |
  sed '$ ! s/$/,/')

{
  # .pragma library makes this a shared, stateless library: parsed once for the
  # whole shell rather than once per panel.
  echo ".pragma library"
  echo "// Generated by bin/build-renderer from the qrgen app - do not edit."
  echo "// Rebuild with: bin/build-renderer [path-to-qrgen-checkout]"
  echo "// Bundles qrgen and lean-qr, both MIT - see LICENSE and THIRD-PARTY.md."
  cat <<'PRELUDE'

// QML's engine is not a browser, and lean-qr expects two things from one.
//
// TextEncoder it uses to measure and emit UTF-8, which matters here: an emoji
// payload is UTF-8 bytes, so this has to be right rather than approximate.
//
// TextDecoder it uses only to build the Shift-JIS lookup that decides whether
// kanji mode would make a smaller code. That table is 7973 entries of encoding
// data, which is not worth carrying in a bar widget, so this stub declines the
// question: Japanese text still encodes, as UTF-8, in a slightly larger code.
var TextEncoder = function () {};
TextEncoder.prototype.encode = function (input) {
  var text = String(input);
  var bytes = [];
  for (var i = 0; i < text.length; i++) {
    var point = text.codePointAt(i);
    if (point > 0xFFFF) i++; // the pair is one code point
    if (point < 0x80) {
      bytes.push(point);
    } else if (point < 0x800) {
      bytes.push(0xC0 | (point >> 6), 0x80 | (point & 63));
    } else if (point < 0x10000) {
      bytes.push(0xE0 | (point >> 12), 0x80 | ((point >> 6) & 63), 0x80 | (point & 63));
    } else {
      bytes.push(0xF0 | (point >> 18), 0x80 | ((point >> 12) & 63),
                 0x80 | ((point >> 6) & 63), 0x80 | (point & 63));
    }
  }
  return new Uint8Array(bytes);
};

var TextDecoder = function () {};
TextDecoder.prototype.decode = function () { return "\uFFFD"; };
PRELUDE
  # Cut the statement, not the line it sits on: minified output puts the whole
  # bundle on a handful of lines, so dropping one takes the code with it.
  sed -E 's/export[[:space:]]*\{[^}]*\}[[:space:]]*;?//g' "$down"
  echo "var QrGenCore = {"
  echo "$members"
  echo "};"
} > "$plugin/renderer.js"

# Syntax QML rejects. Cheap to check, and the failure it prevents is "the panel
# silently renders nothing", which is not obvious from anywhere else.
if grep -qE '\?\?=|\|\|=|&&=' "$plugin/renderer.js"; then
  echo "Bundle still contains logical assignment operators" >&2; exit 1
fi
if grep -qE '\.\.\.[A-Za-z0-9_$]+\}' "$plugin/renderer.js"; then
  echo "Bundle still contains object rest in a destructuring pattern" >&2; exit 1
fi
if grep -qE '(^|[^A-Za-z0-9_$.])(export|import)[ {(]' "$plugin/renderer.js"; then
  echo "A module statement survived the rewrite" >&2; exit 1
fi
if grep -q "BigInt" "$plugin/renderer.js"; then
  echo "Bundle references BigInt, which QML's engine does not have" >&2; exit 1
fi

printf 'renderer.js: %s\n' "$(du -h "$plugin/renderer.js" | cut -f1)"
